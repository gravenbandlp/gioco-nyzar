// Il gioco pubblicato come Worker con i soli file statici di dist/ (docs/locale.md).
// Nessuno script: Cloudflare serve dist/ così com'è, con le intestazioni di public/_headers.
{
  "name": "gioco-nyzar",
  "compatibility_date": "2026-10-01",
  // il dominio proprio: dalla rete di casa *.workers.dev e *.pages.dev rallentano, i domini propri no
  "routes": [{ "pattern": "ludus.nyzar.net", "custom_domain": true }],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    // come su Pages: /privacy apre privacy.html, un indirizzo sconosciuto riapre il gioco
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  }
}
