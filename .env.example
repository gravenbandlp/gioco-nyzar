# Copia questo file in .env.local (non va in git) e riempi i valori del tuo progetto Supabase (docs/locale.md).
# Senza queste due righe il login Google non compare e il gioco salva solo nel browser e su file.
VITE_SUPABASE_URL=https://<progetto>.supabase.co
VITE_SUPABASE_CHIAVE=<chiave anon o publishable, quella pubblica>

# Per generare le voci in automatico (npm run doppiaggio). Senza prefisso VITE_: resta fuori dal gioco.
ELEVENLABS_API_KEY=<chiave API di ElevenLabs>
