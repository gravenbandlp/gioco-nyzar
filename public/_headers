/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Tavole e audio tengono lo stesso nome se li sostituisci: un giorno in cache, poi
# per una settimana il browser usa la copia vecchia mentre scarica quella nuova.
# Senza, a ogni cambio di scheda il browser richiedeva ogni tavola a Cloudflare.
/tavole/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/audio/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
